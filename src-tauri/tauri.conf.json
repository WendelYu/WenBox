{
  "build": {
    "beforeDevCommand": "node scripts/prepare-kvm-backend.cjs",
    "beforeBuildCommand": "node scripts/prepare-kvm-backend.cjs",
    "devPath": "../app/src/main/assets/web",
    "distDir": "../app/src/main/assets/web",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "WenBox",
    "version": "1.4.9"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "clipboard": {
        "writeText": true,
        "readText": true
      },
      "shell": {
        "all": false,
        "open": true
      },
      "dialog": {
        "all": true,
        "open": true,
        "save": true
      },
      "fs": {
        "all": false,
        "readFile": true,
        "writeFile": true,
        "createDir": true,
        "exists": true,
        "scope": [
          "$DOWNLOAD/**",
          "$DESKTOP/**",
          "$DOCUMENT/**",
          "$HOME/**",
          "$TEMP/**"
        ]
      },
      "path": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.wendel.wenbox",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico",
        "icons/icon.png"
      ],
      "windows": {
        "webviewInstallMode": {
          "type": "skip"
        },
        "nsis": {
          "installMode": "perMachine",
          "template": "resources/kvm/installer.nsi",
          "languages": [
            "SimpChinese",
            "English"
          ],
          "displayLanguageSelector": true
        }
      },
      "macOS": {
        "minimumSystemVersion": "12.3"
      },
      "resources": [
        "resources/kvm/"
      ]
    },
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http: https:; connect-src 'self' http: https: ipc: https://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'"
    },
    "windows": [
      {
        "title": "WenBox",
        "width": 1100,
        "height": 780,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "fileDropEnabled": false
      }
    ]
  }
}
