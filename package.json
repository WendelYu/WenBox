{
  "name": "wenbox",
  "version": "1.4.0",
  "description": "WenBox - 工控现场与工程师百宝箱",
  "main": "main.js",
  "scripts": {
    "test": "node --test",
    "start": "electron .",
    "test:desktop": "node scripts/check-electron-ui.cjs",
    "dist:win": "electron-builder --win --x64 -p never",
    "lint:css": "stylelint \"app/src/main/assets/web/*.css\""
  },
  "author": "Wendel",
  "license": "MIT",
  "devDependencies": {
    "electron": "=44.8.0",
    "electron-builder": "=26.15.3",
    "stylelint": "=16.11.0",
    "stylelint-config-standard": "=36.0.1"
  },
  "build": {
    "appId": "com.wendel.wenbox",
    "productName": "WenBox",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "main.js",
      "preload.js",
      "desktop-server.js",
      "app/src/main/assets/web/**/*"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
