<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.LanDrop" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/text_1</item>
        <item name="colorSurface">@color/surface_1</item>
        <item name="colorOnSurface">@color/text_1</item>
        <item name="colorOutline">@color/border</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <!-- 深色主题下状态栏图标必须是浅色；浅色主题（Phase 4）在 values/ 覆盖 -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <!-- 透明指示器，避免选中 Tab 时出现突兀的白色盖字药丸框 -->
    <style name="Widget.Material3.BottomNavigationView.ActiveIndicator.Transparent" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <!-- ==== 文字样式：对应 tokens.css 的 6 档字号，对应 14/16/13/12sp ==== -->
    <style name="TextAppearance.WenBox.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/fs_md</item>
        <item name="android:textColor">@color/text_1</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <style name="TextAppearance.WenBox.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/fs_lg</item>
        <item name="android:textColor">@color/text_1</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.WenBox.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/fs_sm</item>
        <item name="android:textColor">@color/text_2</item>
    </style>

    <style name="TextAppearance.WenBox.Badge" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/fs_xs</item>
        <item name="android:textColor">@color/text_2</item>
    </style>

    <!-- ==== 按钮：统一高度与圆角，取消渐变与彩色阴影 ==== -->
    <style name="Widget.WenBox.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textSize">@dimen/fs_md</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">@dimen/r_md</item>
    </style>

    <style name="Widget.WenBox.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textSize">@dimen/fs_md</item>
        <item name="android:textColor">@color/text_1</item>
        <item name="strokeColor">@color/border_strong</item>
        <item name="cornerRadius">@dimen/r_md</item>
    </style>

    <style name="Widget.WenBox.Button.Danger" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textSize">@dimen/fs_md</item>
        <item name="android:textColor">@color/danger_fg</item>
        <item name="strokeColor">@color/danger_fg</item>
        <item name="cornerRadius">@dimen/r_md</item>
    </style>

    <!-- ==== 卡片：1px 边框，无阴影 ==== -->
    <style name="Widget.WenBox.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface_1</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">@dimen/r_lg</item>
        <item name="cardElevation">0dp</item>
    </style>
</resources>
