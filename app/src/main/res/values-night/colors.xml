<?xml version="1.0" encoding="utf-8"?>
<!--
  夜间（深色）主题的 design token。与 values/colors.xml 中的语义名一一对应。
  系统处于深色模式时 Android 自动选用本文件；浅色值定义在 values/colors.xml。
  两处必须保持同一组名字，切换主题时不会出现缺失颜色。
-->
<resources>
    <!-- 表面 -->
    <color name="bg">#101116</color>
    <color name="surface_1">#1B1C26</color>
    <color name="surface_2">#222430</color>
    <color name="surface_3">#2B2E3E</color>
    <color name="border">#303241</color>
    <color name="border_strong">#44475D</color>

    <!-- 文字 -->
    <color name="text_1">#F2F3FA</color>
    <color name="text_2">#B2B5C9</color>
    <color name="text_3">#8B90A8</color>
    <color name="text_disabled">#565C73</color>

    <!-- 语义 -->
    <color name="primary">#635BFF</color>
    <color name="primary_hover">#5148DF</color>
    <color name="primary_fg">#A39DFF</color>
    <color name="primary_soft">#24857BFF</color>
    <color name="success">#047857</color>
    <color name="success_fg">#34D399</color>
    <color name="success_soft">#2434D399</color>
    <color name="warning_fg">#FBBF24</color>
    <color name="warning_soft">#24FBBF24</color>
    <color name="danger">#B91C1C</color>
    <color name="danger_fg">#F87171</color>
    <color name="danger_soft">#24F87171</color>
    <color name="info">#06B6D4</color>
    <color name="chat_accent_purple">#A78BFA</color>
    <color name="on_primary">#FFFFFF</color>
</resources>
