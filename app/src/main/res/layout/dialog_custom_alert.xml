<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvAlertTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_zh_fc247c7a"
        android:textColor="@color/text_1"
        android:textSize="@dimen/fs_xl"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:overScrollMode="ifContentScrolls">

        <TextView
            android:id="@+id/tvAlertMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:text="@string/label_zh_380a3675"
            android:textColor="@color/text_2"
            android:textSize="@dimen/fs_md" />
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAlertOk"
        style="@style/Widget.WenBox.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="end"
        android:layout_marginTop="12dp"
        android:text="@string/action_got_it" />
</LinearLayout>
