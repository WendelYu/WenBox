<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvEditNicknameTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_zh_0e6f6e53"
        android:textColor="@color/text_1"
        android:textSize="@dimen/fs_xl"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvEditNicknameSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/label_ip"
        android:textColor="@color/text_2"
        android:textSize="@dimen/fs_sm" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/label_zh_6c2ac6c9"
        android:textColor="@color/text_1"
        android:textSize="@dimen/fs_sm"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etEditNickname"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_field"
        android:hint="@string/label_zh_fbf6f328"
        android:imeOptions="actionDone"
        android:maxLength="20"
        android:paddingHorizontal="12dp"
        android:singleLine="true"
        android:textColor="@color/text_1"
        android:textColorHint="@color/text_3"
        android:textSize="@dimen/fs_md" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelEditNickname"
            style="@style/Widget.WenBox.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/dialog_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmEditNickname"
            style="@style/Widget.WenBox.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="@string/label_zh_809aa784" />
    </LinearLayout>
</LinearLayout>
