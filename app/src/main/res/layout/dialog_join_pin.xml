<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvJoinRoomTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_zh_48347e7d"
        android:textColor="@color/text_1"
        android:textSize="@dimen/fs_xl"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvJoinRoomSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/label_ip_2"
        android:textColor="@color/text_2"
        android:textSize="@dimen/fs_sm" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_zh_07454e8d"
                android:textColor="@color/text_1"
                android:textSize="@dimen/fs_sm"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etJoinNickname"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:hint="@string/label_zh_5c512f9a"
                android:imeOptions="actionNext"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="@color/text_1"
                android:textColorHint="@color/text_3"
                android:textSize="@dimen/fs_md" />

            <LinearLayout
                android:id="@+id/llPinSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_pin_2"
                    android:textColor="@color/text_1"
                    android:textSize="@dimen/fs_sm"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etJoinPin"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/label_pin_3"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:paddingHorizontal="12dp"
                    android:singleLine="true"
                    android:textColor="@color/text_1"
                    android:textColorHint="@color/text_3"
                    android:textSize="@dimen/fs_md" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvJoinDissolveHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="1dp"
                android:text="@string/join_dissolve_hint"
                android:textColor="@color/text_2"
                android:textSize="@dimen/fs_xs" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelJoinRoom"
            style="@style/Widget.WenBox.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/dialog_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmJoinRoom"
            style="@style/Widget.WenBox.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="@string/label_zh_9e72714f" />
    </LinearLayout>
</LinearLayout>
