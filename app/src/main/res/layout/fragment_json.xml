<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            style="@style/TextAppearance.WenBox.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_json" />

        <TextView
            style="@style/TextAppearance.WenBox.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/label_zh_c56784b1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFormatJson"
                style="@style/Widget.WenBox.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/label_zh_7702a6d2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMinifyJson"
                style="@style/Widget.WenBox.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/label_zh_f1cc3577"
                android:textColor="@color/primary_fg" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLoadSample"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingHorizontal="4dp"
                android:text="@string/label_zh_7d36510f"
                android:textColor="@color/text_2"
                android:textSize="@dimen/fs_sm"
                android:insetBottom="0dp"
                android:insetTop="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyJson"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingHorizontal="4dp"
                android:text="@string/label_zh_3cda0d96"
                android:textColor="@color/text_2"
                android:textSize="@dimen/fs_sm"
                android:insetBottom="0dp"
                android:insetTop="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearJson"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingHorizontal="4dp"
                android:text="@string/action_clear"
                android:textColor="@color/danger_fg"
                android:textSize="@dimen/fs_sm"
                android:insetBottom="0dp"
                android:insetTop="0dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvJsonError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_badge"
            android:backgroundTint="@color/danger_soft"
            android:padding="10dp"
            android:textColor="@color/danger_fg"
            android:textSize="@dimen/fs_sm"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.WenBox.Card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">

            <EditText
                android:id="@+id/etJsonInput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:fontFamily="monospace"
                android:gravity="top|start"
                android:hint="@string/label_json_2"
                android:lineSpacingExtra="3dp"
                android:padding="12dp"
                android:scrollbars="vertical"
                android:textColor="@color/text_1"
                android:textColorHint="@color/text_3"
                android:textSize="@dimen/fs_md" />

        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
