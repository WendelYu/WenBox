<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/llMessageContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_chat_item"
    android:padding="10dp"
    android:orientation="vertical">

    <!-- 顶部消息头：发送者、IP、时间戳与复制按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tvSenderInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/chat_accent_blue"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="（我）📱 本机 (192.168.1.100)" />

        <TextView
            android:id="@+id/tvMessageTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/chat_text_subtle"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginEnd="8dp"
            tools:text="14:32:05" />

        <ImageView
            android:id="@+id/btnCopyMessage"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="3dp"
            android:src="@drawable/ic_copy"
            app:tint="@color/chat_text_muted"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_copy_content" />

    </LinearLayout>

    <!-- 消息主体文本 (等宽字体，支持保留缩进和排版) -->
    <TextView
        android:id="@+id/tvMessageContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/chat_text_main"
        android:textColorLink="@color/chat_accent_blue"
        android:textSize="13.5sp"
        android:lineSpacingExtra="3dp"
        android:typeface="monospace"
        android:textIsSelectable="true"
        tools:text="这是来自设备发送的文本或代码" />

    <!-- 图片缩略图预览卡片 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvMessageImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="2dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#181818"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ivMessageImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:maxWidth="280dp"
                android:maxHeight="260dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/cd_chat_image" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="4dp"
                android:background="#B3000000"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="@string/cd_view_original"
                android:textColor="#E0E0E0"
                android:textSize="10sp" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
