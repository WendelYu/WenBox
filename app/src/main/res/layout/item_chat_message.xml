<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llMessageContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvSenderInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="3dp"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        tools:text="💻 电脑端 (192.168.1.100) • 14:32:05" />

    <LinearLayout
        android:id="@+id/llBubbleRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom">

        <TextView
            android:id="@+id/tvMessageContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="280dp"
            android:background="@drawable/bg_chat_bubble_other"
            android:paddingHorizontal="14dp"
            android:paddingVertical="9dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp"
            android:textIsSelectable="true"
            tools:text="这是来自电脑端发过来的文本或链接" />

        <ImageView
            android:id="@+id/btnCopyMessage"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:padding="5dp"
            android:src="@drawable/ic_copy"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="复制内容" />

    </LinearLayout>

</LinearLayout>
