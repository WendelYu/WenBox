<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toolSelector" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingHorizontal="16dp"
        app:singleSelection="true" app:selectionRequired="true">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/toolJson" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:minHeight="48dp" android:text="@string/nav_json" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/toolConverter" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:minHeight="48dp" android:text="@string/nav_converter" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/toolCron" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:minHeight="48dp" android:text="@string/nav_cron" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
    <androidx.viewpager2.widget.ViewPager2 android:id="@+id/toolPager"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
