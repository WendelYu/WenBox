<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toolSelector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toolJson"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="48dp"
            android:paddingHorizontal="4dp"
            android:text="@string/nav_json"
            android:textSize="@dimen/fs_sm"
            android:insetBottom="0dp"
            android:insetTop="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toolConverter"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="48dp"
            android:paddingHorizontal="4dp"
            android:text="@string/nav_converter"
            android:textSize="@dimen/fs_sm"
            android:insetBottom="0dp"
            android:insetTop="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toolCron"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="48dp"
            android:paddingHorizontal="4dp"
            android:text="@string/nav_cron"
            android:textSize="@dimen/fs_sm"
            android:insetBottom="0dp"
            android:insetTop="0dp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/toolPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
