<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/converter_title"
                    android:textColor="@color/text_1"
                    android:textSize="@dimen/fs_xl"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/converter_subtitle"
                    android:textColor="@color/text_2"
                    android:textSize="@dimen/fs_sm" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearAll"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/action_clear"
                android:textColor="@color/danger_fg"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvConverterError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_badge"
            android:backgroundTint="@color/danger_soft"
            android:padding="10dp"
            android:textColor="@color/danger_fg"
            android:textSize="@dimen/fs_sm"
            android:visibility="gone"
            tools:text="不支持负数，请输入非负整数" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.WenBox.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="4dp">

                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:text="@string/converter_hex_label"
                        android:textColor="@color/primary_fg"
                        android:textSize="@dimen/fs_xs"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etHex"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginHorizontal="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_field"
                        android:fontFamily="monospace"
                        android:hint="@string/converter_hex_hint"
                        android:paddingHorizontal="10dp"
                        android:singleLine="true"
                        android:textColor="@color/text_1"
                        android:textColorHint="@color/text_3"
                        android:textSize="@dimen/fs_md" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopyHex"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="56dp"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:paddingHorizontal="2dp"
                        android:text="@string/action_copy"
                        android:textSize="@dimen/fs_xs"
                        app:cornerRadius="@dimen/r_md"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@color/border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="4dp">

                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:text="@string/converter_dec_label"
                        android:textColor="@color/primary_fg"
                        android:textSize="@dimen/fs_xs"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDec"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginHorizontal="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_field"
                        android:fontFamily="monospace"
                        android:hint="@string/converter_dec_hint"
                        android:inputType="number"
                        android:paddingHorizontal="10dp"
                        android:singleLine="true"
                        android:textColor="@color/text_1"
                        android:textColorHint="@color/text_3"
                        android:textSize="@dimen/fs_md" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopyDec"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="56dp"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:paddingHorizontal="2dp"
                        android:text="@string/action_copy"
                        android:textSize="@dimen/fs_xs"
                        app:cornerRadius="@dimen/r_md"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@color/border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="4dp">

                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:text="@string/converter_bin_label"
                        android:textColor="@color/primary_fg"
                        android:textSize="@dimen/fs_xs"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBin"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginHorizontal="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_field"
                        android:fontFamily="monospace"
                        android:hint="@string/converter_bin_hint"
                        android:paddingHorizontal="10dp"
                        android:singleLine="true"
                        android:textColor="@color/text_1"
                        android:textColorHint="@color/text_3"
                        android:textSize="@dimen/fs_md" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopyBin"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="56dp"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:paddingHorizontal="2dp"
                        android:text="@string/action_copy"
                        android:textSize="@dimen/fs_xs"
                        app:cornerRadius="@dimen/r_md"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@color/border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="4dp">

                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:text="@string/converter_oct_label"
                        android:textColor="@color/primary_fg"
                        android:textSize="@dimen/fs_xs"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOct"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginHorizontal="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_field"
                        android:fontFamily="monospace"
                        android:hint="@string/converter_oct_hint"
                        android:paddingHorizontal="10dp"
                        android:singleLine="true"
                        android:textColor="@color/text_1"
                        android:textColorHint="@color/text_3"
                        android:textSize="@dimen/fs_md" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopyOct"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="56dp"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:paddingHorizontal="2dp"
                        android:text="@string/action_copy"
                        android:textSize="@dimen/fs_xs"
                        app:cornerRadius="@dimen/r_md"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@color/border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="4dp">

                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:text="@string/converter_ascii_label"
                        android:textColor="@color/primary_fg"
                        android:textSize="@dimen/fs_xs"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAscii"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginHorizontal="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_field"
                        android:hint="@string/converter_ascii_hint"
                        android:paddingHorizontal="10dp"
                        android:singleLine="true"
                        android:textColor="@color/text_1"
                        android:textColorHint="@color/text_3"
                        android:textSize="@dimen/fs_md" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopyAscii"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="56dp"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:paddingHorizontal="2dp"
                        android:text="@string/action_copy"
                        android:textSize="@dimen/fs_xs"
                        app:cornerRadius="@dimen/r_md"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
